# ============================================================
# Configuration AinaWeb — copier en `.env` puis adapter
#   Windows PowerShell :  Copy-Item .env.example .env
#   Linux / macOS      :  cp .env.example .env
# ============================================================
# Le fichier `.env` n'est PAS versionné (voir .gitignore).
# En local (WAMP), les valeurs par défaut suffisent : aucune variable
# n'est nécessaire pour lancer `run.bat`.

# ——— Base de données MySQL ———
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ainalalana
DB_USER=root
DB_PASSWORD=

# Bases managées exigeant TLS (TiDB Cloud, Aiven, Railway...)
# DB_SSL=true
# DB_SSL_CA=/chemin/vers/ca.pem

# ——— Serveur Flask ———
# Port d'écoute (la plupart des hébergeurs l'imposent via $PORT)
PORT=5000

# Détail des erreurs renvoyé par l'API.
# 1 = développement (messages détaillés) | 0 = production (messages génériques)
DEBUG_ERREURS=1

# Rechargement automatique Flask (développement uniquement)
FLASK_DEBUG=0

# Endpoint de diagnostic /api/admin/debug/etat (0 = désactivé)
ENABLE_DEBUG_API=0
