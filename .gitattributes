# Normalisation des fins de ligne (évite les diffs bruyants sous Windows)
* text=auto eol=lf

# Scripts Windows : doivent rester en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaires : jamais de conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
